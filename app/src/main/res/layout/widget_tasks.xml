<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/taskWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <TextView
        android:id="@+id/taskThemeMark"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text=""
        android:textSize="34sp"
        android:textStyle="bold"
        android:singleLine="true"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/taskWidgetHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layoutDirection="rtl">

            <TextView
                android:id="@+id/taskWidgetTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="مفكرتي"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:singleLine="true"/>

            <TextView
                android:id="@+id/taskWidgetCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="بانتظار المزامنة"
                android:textColor="#C8FFFFFF"
                android:textSize="12sp"
                android:singleLine="true"/>
        </LinearLayout>

        <TextView
            android:id="@+id/taskSyncHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="افتح «مفكرتي» مرة واحدة لتظهر المهام هنا"
            android:textColor="#C8FFFFFF"
            android:textSize="11sp"/>

        <TextView
            android:id="@+id/taskTodayHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="اليوم"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:gravity="start"
            android:layoutDirection="rtl"/>

        <LinearLayout android:id="@+id/taskTodayRow1" style="@style/TaskWidgetRow">
            <TextView android:id="@+id/taskTodayTitle1" style="@style/TaskWidgetTitle"/>
            <TextView android:id="@+id/taskTodayMeta1" style="@style/TaskWidgetMeta"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/taskTodayRow2" style="@style/TaskWidgetRow">
            <TextView android:id="@+id/taskTodayTitle2" style="@style/TaskWidgetTitle"/>
            <TextView android:id="@+id/taskTodayMeta2" style="@style/TaskWidgetMeta"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/taskTodayRow3" style="@style/TaskWidgetRow">
            <TextView android:id="@+id/taskTodayTitle3" style="@style/TaskWidgetTitle"/>
            <TextView android:id="@+id/taskTodayMeta3" style="@style/TaskWidgetMeta"/>
        </LinearLayout>

        <TextView
            android:id="@+id/taskLateHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="المتأخرة"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:gravity="start"
            android:layoutDirection="rtl"/>

        <LinearLayout android:id="@+id/taskLateRow1" style="@style/TaskWidgetRow">
            <TextView android:id="@+id/taskLateTitle1" style="@style/TaskWidgetTitle"/>
            <TextView android:id="@+id/taskLateMeta1" style="@style/TaskWidgetMeta"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/taskLateRow2" style="@style/TaskWidgetRow">
            <TextView android:id="@+id/taskLateTitle2" style="@style/TaskWidgetTitle"/>
            <TextView android:id="@+id/taskLateMeta2" style="@style/TaskWidgetMeta"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/taskLateRow3" style="@style/TaskWidgetRow">
            <TextView android:id="@+id/taskLateTitle3" style="@style/TaskWidgetTitle"/>
            <TextView android:id="@+id/taskLateMeta3" style="@style/TaskWidgetMeta"/>
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
