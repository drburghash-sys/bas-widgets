<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/basWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <TextView
        android:id="@+id/basThemeMark"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text=""
        android:textColor="#22FFFFFF"
        android:textSize="34sp"
        android:textStyle="bold"
        android:singleLine="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layoutDirection="ltr">

        <TextView
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:gravity="center"
            android:background="@drawable/bas_badge_background"
            android:text="BAS"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/basTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="BAS Platform"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:id="@+id/basSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Burghash App Systems"
                android:textColor="#D0FFFFFF"
                android:textSize="13sp"
                android:singleLine="true" />

            <TextView
                android:id="@+id/basHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="اضغط لفتح المنصة"
                android:textColor="#A8FFFFFF"
                android:textSize="11sp"
                android:singleLine="true" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
