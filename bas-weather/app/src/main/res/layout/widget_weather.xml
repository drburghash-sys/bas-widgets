<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/weatherRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:background="@drawable/widget_weather_bg"
    android:padding="11dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layoutDirection="rtl">

        <!-- RIGHT: weather, kept close to V1 structure -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.6"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layoutDirection="rtl">

            <FrameLayout
                android:layout_width="92dp"
                android:layout_height="82dp">

                <TextView
                    android:id="@+id/weatherIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="☀️"
                    android:textSize="48sp"/>

                <TextView
                    android:id="@+id/weatherDust"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="≋≋"
                    android:textColor="#F0D2A2"
                    android:textStyle="bold"
                    android:textSize="23sp"
                    android:visibility="gone"/>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:layoutDirection="rtl">

                <TextView
                    android:id="@+id/weatherTemp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="--°"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="31sp"/>

                <TextView
                    android:id="@+id/weatherCondition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="جاري التحديث"
                    android:textColor="#E8F3FF"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/weatherHumidity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="💧 الرطوبة --٪"
                    android:textColor="#B8DFFF"
                    android:textSize="13sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Divider: TextView is RemoteViews-safe -->
        <TextView
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="#2EFFFFFF"
            android:text=""/>

        <!-- LEFT: place + battery -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="4dp"
            android:layoutDirection="rtl">

            <TextView
                android:id="@+id/weatherCity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="📍 تبوك"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="17sp"
                android:singleLine="true"/>

            <TextView
                android:id="@+id/weatherDistrict"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="1dp"
                android:text="الحي"
                android:textColor="#C7D7E4"
                android:textStyle="bold"
                android:textSize="12sp"
                android:singleLine="true"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:layoutDirection="ltr">

                <ImageView
                    android:id="@+id/batteryIcon"
                    android:layout_width="46dp"
                    android:layout_height="30dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_battery_mid"/>

                <TextView
                    android:id="@+id/batteryPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="--٪"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="27sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/batteryLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="البطارية"
                android:textColor="#8BC7FF"
                android:textStyle="bold"
                android:textSize="10sp"/>

            <TextView
                android:id="@+id/weatherRefresh"
                android:layout_width="44dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="↻"
                android:textColor="#CCFFFFFF"
                android:textSize="22sp"/>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/weatherUpdated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:text="اضغط ↻ للتحديث"
        android:textColor="#99FFFFFF"
        android:textSize="10sp"/>
</LinearLayout>